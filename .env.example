# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenRouter — all LLM calls go through it (see docs/en/ARCHITECTURE.md).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model for board agents (cheap; per-role overrides live in role config).
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Postgres connection for the platform core (Phase 1).
# Default matches the docker-compose dev setup.
DATABASE_URL=postgres://csuite:csuite@localhost:5432/csuite

# Host port docker-compose publishes Postgres on. Only set this if 5432 is
# already taken on your machine — and change the port in DATABASE_URL to match.
# POSTGRES_PORT=5432

# Platform API (server/). Defaults: 3001 on 127.0.0.1.
# PORT=3001
# HOST=127.0.0.1
# LOG_LEVEL=info
