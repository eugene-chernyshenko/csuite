# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenRouter — all LLM calls go through it (see docs/en/ARCHITECTURE.md).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Postgres connection for the platform core (Phase 1).
# Default matches the docker-compose dev setup.
DATABASE_URL=postgres://csuite:csuite@localhost:5432/csuite
