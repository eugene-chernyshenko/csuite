{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    /*
     * "bundler", not "nodenext": @csuite/contract is consumed as TypeScript
     * source, and both runtimes here (tsx for dev/start, vitest for tests)
     * resolve it that way. `npm run build` is therefore a type-check gate
     * rather than an emit — see server/README-less note in package.json.
     */
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "drizzle.config.ts", "vitest.config.ts"]
}
